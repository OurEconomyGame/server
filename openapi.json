{
	"openapi": "3.0.3",
	"info": {
		"title": "OurEconomy API",
		"description": "API documentation for the OurEconomy backend server.",
		"version": "0.14.0"
	},
	"paths": {
		"/version": {
			"get": {
				"summary": "Get application version",
				"responses": {
					"200": {
						"description": "Returns current API version",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"version": {
											"type": "string",
											"example": "0.14.0"
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"/docs": {
			"get": {
				"summary": "Scalar Interactive API Documentation (Localhost only)",
				"responses": {
					"200": {
						"description": "Returns Scalar HTML API explorer"
					},
					"403": {
						"description": "Forbidden if accessed remotely"
					}
				}
			}
		},
		"/list/users": {
			"get": {
				"summary": "Get list of users public info",
				"parameters": [
					{
						"name": "sortBy",
						"in": "query",
						"required": false,
						"description": "Field to sort by ('name' or 'id')",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Returns list of public user info objects",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
											"id": {
												"type": "number"
											},
											"username": {
												"type": "string"
											},
											"joined": {
												"type": "number"
											},
											"active": {
												"type": "number"
											}
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"/list/companies": {
			"get": {
				"summary": "Get list of companies with public info and optional CEO data",
				"parameters": [
					{
						"name": "Auth",
						"in": "header",
						"required": false,
						"description": "Optional session token to expose private company data if caller is CEO",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "sortBy",
						"in": "query",
						"required": false,
						"description": "Field to sort by ('name', 'created_at', or 'id')",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "type",
						"in": "query",
						"required": false,
						"description": "Filter by company type enum",
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "founder_id",
						"in": "query",
						"required": false,
						"description": "Filter by founder user ID",
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "ceo",
						"in": "query",
						"required": false,
						"description": "Filter by CEO user ID",
						"schema": {
							"type": "integer"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Returns list of companies",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
											"id": { "type": "number" },
											"name": { "type": "string" },
											"founder_id": { "type": "number" },
											"type": { "type": "number" },
											"last_accessed": { "type": "number" },
											"created_at": { "type": "number" },
											"ceo": { "type": "number" },
											"shares_outstanding": { "type": "number" },
											"data": {
												"type": "object",
												"description": "Included only if caller is the CEO"
											}
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"/company": {
			"get": {
				"summary": "Get single company details by ID or Name",
				"parameters": [
					{
						"name": "Auth",
						"in": "header",
						"required": false,
						"description": "Optional session token to expose private data if caller is CEO",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "id",
						"in": "query",
						"required": false,
						"description": "Company ID",
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "name",
						"in": "query",
						"required": false,
						"description": "Company Name",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Returns company profile",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"status": { "type": "string" },
										"company": {
											"type": "object",
											"properties": {
												"id": { "type": "number" },
												"name": { "type": "string" },
												"founder_id": { "type": "number" },
												"type": { "type": "number" },
												"last_accessed": { "type": "number" },
												"created_at": { "type": "number" },
												"ceo": { "type": "number" },
												"shares_outstanding": { "type": "number" },
												"data": {
													"type": "object",
													"description": "Included only if caller is the CEO"
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"/company/shareholders": {
			"get": {
				"summary": "Get cap table / shareholder distribution for a company",
				"parameters": [
					{
						"name": "id",
						"in": "query",
						"required": false,
						"description": "Company ID",
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "name",
						"in": "query",
						"required": false,
						"description": "Company Name",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Returns cap table",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"status": { "type": "string" },
										"company_id": { "type": "number" },
										"shares_outstanding": { "type": "number" },
										"shareholders": {
											"type": "array",
											"items": {
												"type": "object",
												"properties": {
													"share_id": { "type": "number" },
													"owner_id": { "type": "number" },
													"owner_user": { "type": "boolean" },
													"quantity": { "type": "number" },
													"percentage": { "type": "number" }
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"/portfolio": {
			"get": {
				"summary": "Get authenticated user's portfolio of shares across all companies",
				"parameters": [
					{
						"name": "Auth",
						"in": "header",
						"required": true,
						"description": "Session token for authentication",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Returns array of share holdings",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"status": { "type": "string" },
										"portfolio": {
											"type": "array",
											"items": {
												"type": "object",
												"properties": {
													"share_id": { "type": "number" },
													"company_id": { "type": "number" },
													"company_name": { "type": "string" },
													"company_type": { "type": "number" },
													"quantity": { "type": "number" },
													"shares_outstanding": { "type": "number" },
													"ownership_percentage": { "type": "number" }
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"/signup": {
			"post": {
				"summary": "Create a new user",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["hi", "secret"],
								"properties": {
									"hi": {
										"type": "string",
										"description": "Username"
									},
									"secret": {
										"type": "string",
										"description": "Password"
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "User creation status, ID, and session token",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"status": {
											"type": "string"
										},
										"id": {
											"type": "number"
										},
										"random": {
											"type": "string",
											"description": "Session token generated for the created user"
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"/login": {
			"post": {
				"summary": "User login",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["hi", "secret"],
								"properties": {
									"hi": {
										"type": "string",
										"description": "Username"
									},
									"secret": {
										"type": "string",
										"description": "Password"
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Login response status and token",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"status": {
											"type": "string"
										},
										"token": {
											"type": "string"
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"/found": {
			"post": {
				"summary": "Found a new company",
				"parameters": [
					{
						"name": "Auth",
						"in": "header",
						"required": true,
						"description": "Session token for authentication",
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["name", "type"],
								"properties": {
									"name": {
										"type": "string",
										"description": "Name of the company"
									},
									"type": {
										"type": "integer",
										"enum": [0, 1, 2],
										"description": "Company type (0: Production, 1: Holding, 2: WebStore)"
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Company founding response with status and created company ID",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"status": {
											"type": "string"
										},
										"id": {
											"type": "number"
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
